#!/usr/bin/env python3
import argparse
import getpass
import os
import shutil
import subprocess
import tempfile

import keyring
import requests
from keyring.errors import KeyringError

BASE_URL = "http://server-ip-port-here"
KEYRING_SERVICE = "tag-system"
KEYRING_ACCOUNT = BASE_URL


def get_api_key():
    try:
        api_key = keyring.get_password(KEYRING_SERVICE, KEYRING_ACCOUNT)
    except KeyringError as exc:
        raise SystemExit(f"Could not read API key from system keyring: {exc}")

    if not api_key:
        raise SystemExit("No API key configured. Run: tag configure")

    return api_key


def headers():
    return {"x-api-key": get_api_key()}


def configure(args):
    api_key = getpass.getpass("API key: ").strip()
    if not api_key:
        print("API key was not changed")
        return

    try:
        keyring.set_password(KEYRING_SERVICE, KEYRING_ACCOUNT, api_key)
    except KeyringError as exc:
        raise SystemExit(f"Could not save API key to system keyring: {exc}")

    print("API key saved to system keyring")


def add(args):
    data = []
    files = []
    opened_files = []

    for text in args.text or []:
        data.append(("text", text))

    for url in args.url or []:
        data.append(("url", url))

    try:
        for file_path in args.file or []:
            path = os.path.expanduser(file_path)
            if not os.path.isfile(path):
                print("File does not exist:", path)
                return

            handle = open(path, "rb")
            opened_files.append(handle)
            files.append(("file", (os.path.basename(path), handle)))

        res = requests.post(
            f"{BASE_URL}/tags/{args.name}/add",
            data=data,
            files=files,
            headers=headers(),
        )
        res.raise_for_status()
        print("Saved")
    finally:
        for handle in opened_files:
            handle.close()


def show(args):
    res = requests.get(f"{BASE_URL}/tags/{args.name}", headers=headers())
    if res.status_code != 200:
        print(res.json().get("detail"))
        return
    tag = res.json()
    if not tag["items"]:
        print("No items in tag")
        return
    for i, item in enumerate(tag["items"]):
        t = item["type"]
        if t in ["text", "url"]:
            print(f"[{i}] {t.upper()}: {item['content']}")
        elif t == "file":
            print(f"[{i}] FILE: {item['filename']} (Windows path: {item['path']})")


def show_all(args):
    auth_headers = headers()
    res = requests.get(f"{BASE_URL}/tags", headers=auth_headers)
    tags = res.json()

    if not tags:
        print("No tags found")
        return

    for name in tags:
        print(f"\n=== {name} ===")
        res = requests.get(f"{BASE_URL}/tags/{name}", headers=auth_headers)
        if res.status_code != 200:
            print("Error:", res.json().get("detail"))
            continue

        tag = res.json()
        if not tag["items"]:
            print("No items")
            continue

        for i, item in enumerate(tag["items"]):
            t = item["type"]
            if t in ["text", "url"]:
                print(f"[{i}] {t.upper()}: {item['content']}")
            elif t == "file":
                print(f"[{i}] FILE: {item['filename']} (Windows path: {item['path']})")


def get(args):
    auth_headers = headers()
    res = requests.get(f"{BASE_URL}/tags/{args.name}", headers=auth_headers)
    if res.status_code != 200:
        print(res.json().get("detail"))
        return

    tag = res.json()
    clipboard_text = ""

    for item in tag["items"]:
        if item["type"] in ["text", "url"]:
            clipboard_text += item["content"] + "\n"
        elif item["type"] == "file":
            filename = item["filename"]
            tmp_path = os.path.join(tempfile.gettempdir(), filename)
            file_url = f"{BASE_URL}/download/{args.name}/{filename}"
            r = requests.get(file_url, headers=auth_headers, stream=True)
            r.raise_for_status()

            with open(tmp_path, "wb") as f:
                shutil.copyfileobj(r.raw, f)

            clipboard_text += f"[file: {tmp_path}]\n"

            try:
                with open(tmp_path, "r", encoding="utf-8") as f:
                    clipboard_text += f.read() + "\n"
            except (UnicodeDecodeError, OSError):
                clipboard_text += "[binary file contents not displayed]\n"

            if args.open_files:
                subprocess.Popen(["xdg-open", tmp_path])

    subprocess.run(
        ["xclip", "-selection", "clipboard"],
        input=clipboard_text.strip().encode(),
        check=True,
    )
    print("Copied to clipboard")


def list_tags(args):
    res = requests.get(f"{BASE_URL}/tags", headers=headers())
    res.raise_for_status()
    for tag_name in res.json():
        print(tag_name)


def delete(args):
    res = requests.delete(f"{BASE_URL}/tags/{args.name}", headers=headers())
    if res.status_code == 404:
        print("Tag not found")
    else:
        res.raise_for_status()
        print("Deleted")


def search(args):
    res = requests.get(f"{BASE_URL}/tags/search/{args.query}", headers=headers())
    res.raise_for_status()
    for tag_name in res.json():
        print(tag_name)


parser = argparse.ArgumentParser(
    description="Store and retrieve text, URLs, and files from the Tag System server."
)
sub = parser.add_subparsers(dest="command")

p = sub.add_parser("configure", help="Save or replace the API key in the system keyring")
p.set_defaults(func=configure)

p = sub.add_parser("add", help="Add one or more items to a tag")
p.add_argument("name")
p.add_argument("--text", action="append", help="Text item to add; may be repeated")
p.add_argument("--url", action="append", help="URL item to add; may be repeated")
p.add_argument("--file", action="append", help="File to upload; may be repeated")
p.set_defaults(func=add)

p = sub.add_parser("show", help="Show one tag without changing the clipboard")
p.add_argument("name")
p.set_defaults(func=show)

p = sub.add_parser("show-all", help="Show every tag and all stored items")
p.set_defaults(func=show_all)

p = sub.add_parser("get", help="Copy tag contents to the clipboard")
p.add_argument("name")
p.add_argument("--open-files", action="store_true", help="Open downloaded files with xdg-open")
p.set_defaults(func=get)

p = sub.add_parser("list", help="List tag names")
p.set_defaults(func=list_tags)

p = sub.add_parser("delete", help="Delete a tag and its stored files")
p.add_argument("name")
p.set_defaults(func=delete)

p = sub.add_parser("search", help="Search tag names")
p.add_argument("query")
p.set_defaults(func=search)

args = parser.parse_args()
if hasattr(args, "func"):
    args.func(args)
else:
    parser.print_help()
