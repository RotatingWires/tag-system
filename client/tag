#!/usr/bin/env python3
import argparse, requests, os, subprocess, tempfile, shutil

BASE_URL = "http://server-ip-port-here"
API_KEY = "key-here"

def add(args):
    data = []
    files = []
    opened_files = []

    for text in args.text or []:
        data.append(("text", text))

    for url in args.url or []:
        data.append(("url", url))

    try:
        for file_path in args.file or []:
            path = os.path.expanduser(file_path)
            if not os.path.isfile(path):
                print("File does not exist:", path)
                return

            handle = open(path, "rb")
            opened_files.append(handle)
            files.append(("file", (os.path.basename(path), handle)))

        res = requests.post(
            f"{BASE_URL}/tags/{args.name}/add",
            data=data,
            files=files,
            headers={"x-api-key": API_KEY},
        )
        res.raise_for_status()
        print("Saved")
    finally:
        for handle in opened_files:
            handle.close()

def show(args):
    res = requests.get(f"{BASE_URL}/tags/{args.name}", headers={"x-api-key": API_KEY})
    if res.status_code != 200:
        print(res.json().get("detail"))
        return
    tag = res.json()
    if not tag["items"]:
        print("No items in tag")
        return
    for i, item in enumerate(tag["items"]):
        t = item["type"]
        if t in ["text","url"]:
            print(f"[{i}] {t.upper()}: {item['content']}")
        elif t == "file":
            print(f"[{i}] FILE: {item['filename']} (Windows path: {item['path']})")

def show_all(args):
    res = requests.get(f"{BASE_URL}/tags", headers={"x-api-key": API_KEY})
    tags = res.json()

    if not tags:
        print("No tags found")
        return

    for name in tags:
        print(f"\n=== {name} ===")
        res = requests.get(f"{BASE_URL}/tags/{name}", headers={"x-api-key": API_KEY})
        if res.status_code != 200:
            print("Error:", res.json().get("detail"))
            continue

        tag = res.json()
        if not tag["items"]:
            print("No items")
            continue

        for i, item in enumerate(tag["items"]):
            t = item["type"]
            if t in ["text", "url"]:
                print(f"[{i}] {t.upper()}: {item['content']}")
            elif t == "file":
                print(f"[{i}] FILE: {item['filename']} (Windows path: {item['path']})")

def get(args):
    res = requests.get(f"{BASE_URL}/tags/{args.name}", headers={"x-api-key": API_KEY})
    if res.status_code != 200:
        print(res.json().get("detail"))
        return
    tag = res.json()
    clipboard_text = ""

    for item in tag["items"]:
        if item["type"] in ["text", "url"]:
            clipboard_text += item["content"] + "\n"
        elif item["type"] == "file":
            filename = item["filename"]
            tmp_path = os.path.join(tempfile.gettempdir(), filename)
            file_url = f"{BASE_URL}/download/{args.name}/{filename}"
            r = requests.get(file_url, headers={"x-api-key": API_KEY}, stream=True)
            with open(tmp_path, "wb") as f:
                shutil.copyfileobj(r.raw, f)

            clipboard_text += f"[file: {tmp_path}]\n"

            try:
                with open(tmp_path, "r", encoding="utf-8") as f:
                    clipboard_text += f.read() + "\n"
            except Exception:
                clipboard_text += "[binary file contents not displayed]\n"

            if args.open_files:
                subprocess.Popen(["xdg-open", tmp_path])

    subprocess.run(
        ["xclip", "-selection", "clipboard"],
        input=clipboard_text.strip().encode()
    )
    print("Copied to clipboard")

def list_tags(args):
    res = requests.get(f"{BASE_URL}/tags", headers={"x-api-key": API_KEY})
    for t in res.json():
        print(t)

def delete(args):
    res = requests.delete(f"{BASE_URL}/tags/{args.name}", headers={"x-api-key": API_KEY})
    if res.status_code == 404:
        print("Tag not found")
    else:
        print("Deleted")

def search(args):
    res = requests.get(f"{BASE_URL}/tags/search/{args.query}", headers={"x-api-key": API_KEY})
    for t in res.json():
        print(t)

parser = argparse.ArgumentParser()
sub = parser.add_subparsers()

p = sub.add_parser("add")
p.add_argument("name")
p.add_argument("--text", action="append")
p.add_argument("--url", action="append")
p.add_argument("--file", action="append")
p.set_defaults(func=add)

p = sub.add_parser("show")
p.add_argument("name")
p.set_defaults(func=show)

p = sub.add_parser("show-all")
p.set_defaults(func=show_all)

p = sub.add_parser("get")
p.add_argument("name")
p.add_argument("--open-files", action="store_true")
p.set_defaults(func=get)

p = sub.add_parser("list")
p.set_defaults(func=list_tags)

p = sub.add_parser("delete")
p.add_argument("name")
p.set_defaults(func=delete)

p = sub.add_parser("search")
p.add_argument("query")
p.set_defaults(func=search)

args = parser.parse_args()
if hasattr(args, "func"):
    args.func(args)
else:
    parser.print_help()
